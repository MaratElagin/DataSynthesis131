# Kaggle API credentials (optional — needed only for "Kaggle URL" upload in the UI)
#
# How to get them:
# 1. Log in at https://www.kaggle.com
# 2. Open Account → Settings → API → "Create New Token"
#    (downloads kaggle.json with "username" and "key")
# 3. Copy values here, or place kaggle.json in ~/.kaggle/kaggle.json (local dev)
#
# Docs: https://github.com/Kaggle/kaggle-api#api-credentials

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
