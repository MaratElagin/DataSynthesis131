# Docker Compose env file — copy to platform/.env before `docker compose up`
#
#   cp .env.docker.example .env
#
# Kaggle credentials (optional — for downloading datasets by URL):
# 1. https://www.kaggle.com → Account → Settings → API → Create New Token
# 2. Paste "username" and "key" from the downloaded kaggle.json below
#
# Docs: https://github.com/Kaggle/kaggle-api#api-credentials

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
